# Copy this file to .env and set values for local development
# JWT secret used to sign authentication tokens (keep secret in production)
JWT_SECRET=dev-secret-change-me

# Admin PIN for creating the first admin in bootstrap mode
ADMIN_PIN=admin123

# Optional: set to your MongoDB connection string to use MongoDB instead of file-store
# MONGO_URI=mongodb://localhost:27017/farmtrack

# Backend port (defaults to 5000)
# PORT=5000
# Frontend
VITE_BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api

# Backend
PORT=5000
JWT_SECRET=replace_this
REGISTER_PIN=1234
MONGO_URI=mongodb://localhost:27017/farmtrack
